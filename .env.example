APP_NAME=EasyGrox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost/vellor/admin
# Optional public/storefront origin. If unset, APP_URL without trailing /admin is used
# (local → APP_URL without /admin, staging/prod → that host's public root).
# APP_FRONTEND_URL=https://example.com

# Storefront uses server-rendered Blade (no React SPA in production)
# STOREFRONT_ASSET_BASE=/website/

# Subscriptions: set true to enable Cashfree billing UI, plan limits, and feature gates.
SUBSCRIPTIONS_ENABLED=false

# Cashfree (platform billing)
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
# Optional — override auto-created Cashfree plan IDs (defaults: velor_standard_monthly, etc.)
# CASHFREE_PLAN_STANDARD_MONTHLY=velor_standard_monthly
# CASHFREE_PLAN_STANDARD_YEARLY=velor_standard_yearly
# CASHFREE_PLAN_PREMIUM_MONTHLY=velor_premium_monthly
# CASHFREE_PLAN_PREMIUM_YEARLY=velor_premium_yearly

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# AUTH_REMEMBER_LIFETIME=43200
SESSION_ENCRYPT=false
# Subdirectory installs: match APP_URL path (e.g. /easygrox/admin or /admin). Use / for domain root.
SESSION_PATH=/
SESSION_DOMAIN=null
# Unique per environment so local/live cookies do not collide
# SESSION_COOKIE=easygrox_session
# SESSION_SECURE_COOKIE=true

# Comma-separated hosts that may use cookie/CSRF auth for SPA/AJAX
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,easygrox.com,www.easygrox.com

# Login rate limit (attempts per minute per IP)
RATE_LIMIT_AUTH=10

# Cloudflare Turnstile (login page CAPTCHA)
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=support
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl

# Purpose-specific senders (Google Workspace / SMTP app passwords)
MAIL_ONBOARDING_USERNAME=onboarding@easygrox.com
MAIL_ONBOARDING_PASSWORD=
MAIL_ONBOARDING_FROM=onboarding@easygrox.com
MAIL_ONBOARDING_FROM_NAME="EasyGrox Onboarding"

MAIL_AUTH_USERNAME=auth@easygrox.com
MAIL_AUTH_PASSWORD=
MAIL_AUTH_FROM=auth@easygrox.com
MAIL_AUTH_FROM_NAME="EasyGrox Security"

MAIL_BOOKINGS_USERNAME=bookings@easygrox.com
MAIL_BOOKINGS_PASSWORD=
MAIL_BOOKINGS_FROM=bookings@easygrox.com
MAIL_BOOKINGS_FROM_NAME="EasyGrox Bookings"

MAIL_SUPPORT_USERNAME=support@easygrox.com
MAIL_SUPPORT_PASSWORD=
MAIL_SUPPORT_FROM=support@easygrox.com
MAIL_SUPPORT_FROM_NAME="EasyGrox Support"

MAIL_BILLING_USERNAME=billing@easygrox.com
MAIL_BILLING_PASSWORD=
MAIL_BILLING_FROM=billing@easygrox.com
MAIL_BILLING_FROM_NAME="EasyGrox Billing"

MAIL_FROM_ADDRESS="support@easygrox.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ops inbox: alert on new user signup / new store / tenant feedback
MAIL_OPS_NOTIFY=ajayajatav439@gmail.com
# Optional CC (comma-separated) for the same alerts
MAIL_OPS_NOTIFY_CC=Shiva.ml1991@gmail.com
# Support inbox for tenant project feedback emails
MAIL_SUPPORT_NOTIFY=support@easygrox.com
# Shown on tenant-facing emails
MAIL_SUPPORT_PHONE="+91 99501 05679"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Welcome WhatsApp to new tenants is sent from this sender (default: +91 99501 05679)
TWILIO_WHATSAPP_FROM=whatsapp:+919950105679

VITE_APP_NAME="${APP_NAME}"
